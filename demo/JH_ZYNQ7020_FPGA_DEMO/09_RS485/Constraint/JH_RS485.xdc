create_clock -period 20.000 -name SYS_CLK -waveform {0.000 10.000} [get_ports i_clk]
set_property PACKAGE_PIN W17 [get_ports i_clk]
set_property IOSTANDARD LVCMOS33 [get_ports i_clk]
set_property PACKAGE_PIN W18 [get_ports rst_n]
set_property IOSTANDARD LVCMOS33 [get_ports rst_n]
set_property PACKAGE_PIN AA19 [get_ports rs485_rx1]
set_property IOSTANDARD LVCMOS33 [get_ports rs485_rx1]
set_property PACKAGE_PIN W22 [get_ports rs485_tx1]
set_property IOSTANDARD LVCMOS33 [get_ports rs485_tx1]
set_property PACKAGE_PIN Y20 [get_ports rs485_de1]
set_property IOSTANDARD LVCMOS33 [get_ports rs485_de1]